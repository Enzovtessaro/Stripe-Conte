# Stripe — chave secreta (Developers > API keys)
STRIPE_SECRET_KEY=sk_live_...

# Abacate Pay — chave da API v2 (Dashboard > Integracao)
# Precisa das permissoes CHECKOUT:READ e CUSTOMER:READ.
# Sem esta variavel o dashboard continua funcionando, so sem os pagamentos PIX reais.
ABACATE_PAY_API_KEY=abc_live_...

# Backoffice do Conte — resolve nome, plano e status do cliente de cada cobranca
# PIX (o Abacate nao devolve isso ao listar). Opcional: sem as duas variaveis o
# dashboard mostra a receita do PIX, mas nao ARR, churn nem mix de planos.
CONTE_FUNCTIONS_URL=https://<ref>.supabase.co/functions/v1
CONTE_DASHBOARD_TOKEN=...

# Senha de acesso ao dashboard
DASHBOARD_PASSWORD=...
